NODE_ENV=production
PORT=3000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=replace-me
SUPABASE_ANON_KEY=replace-me

JWT_SECRET=replace-with-output-of-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

CORS_ORIGIN=https://your-vercel-app.vercel.app,https://your-admin-domain.example

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
AUTH_USER_CACHE_TTL_SECONDS=60
LAST_ACTIVE_WRITE_INTERVAL_MS=300000
SLOW_REQUEST_MS=1000
LOG_LEVEL=info

UPI_VPA=your-vpa@bank
UPI_PAYEE_NAME=Your Name
PAYMENT_PROOF_BUCKET=payment-proofs
PAYMENT_INTENT_TTL_HOURS=24
PAYMENT_SUBMISSION_TTL_HOURS=72
RUN_BACKGROUND_JOBS=true

RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
