# UniSage backend — environment variables
# Copy to .env (never commit .env).

# ────────────────────────────────────────────────
# Core
# ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ────────────────────────────────────────────────
# Supabase
# ────────────────────────────────────────────────
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_KEY=<rotate-after-any-leak>
SUPABASE_ANON_KEY=<anon-key>

# ────────────────────────────────────────────────
# JWT
# Generate with: openssl rand -base64 32
# ────────────────────────────────────────────────
JWT_SECRET=<rotate-after-any-leak>
JWT_EXPIRES_IN=7d

# ────────────────────────────────────────────────
# CORS — comma-separated list
# ────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# ────────────────────────────────────────────────
# Rate limiting (defaults shown)
# ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ────────────────────────────────────────────────
# Logging
# ────────────────────────────────────────────────
LOG_LEVEL=info

# ────────────────────────────────────────────────
# Manual UPI payments (Phase A)
# ────────────────────────────────────────────────
# UPI ID money lands in. Verify by scanning the QR with a UPI app before going live.
UPI_VPA=your-vpa@bank
# Display name shown in the UPI app.
UPI_PAYEE_NAME=Your Name
# Supabase Storage bucket holding payment proofs. Must be private. Create
# manually in Supabase UI: Storage → New bucket → "Public" OFF.
PAYMENT_PROOF_BUCKET=payment-proofs
# Hours an intent stays in awaiting_submission before auto-expiring.
PAYMENT_INTENT_TTL_HOURS=24
# Hours a submission stays in pending_verification before auto-expiring
# (admin SLA pressure release valve; defaults generous).
PAYMENT_SUBMISSION_TTL_HOURS=72
# Set to false on additional backend instances when scaling horizontally,
# so background expiry jobs run on exactly one node.
RUN_BACKGROUND_JOBS=true
